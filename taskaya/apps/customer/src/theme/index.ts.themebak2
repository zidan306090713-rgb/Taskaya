  border: '#3B9BFF',
  danger: '#DC2626',
  success: '#16A34A',
  // glass tokens
  glass: 'rgba(255,255,255,0.72)',
  glassStrong: 'rgba(255,255,255,0.9)',
  glassHighlight: 'rgba(255,255,255,0.6)',
  glow: '#2F8CFF',
};
export const spacing = { xs: 4, sm: 8, md: 16, lg: 24, xl: 32 };
export const radius = { sm: 8, md: 14, lg: 22, pill: 999 };
