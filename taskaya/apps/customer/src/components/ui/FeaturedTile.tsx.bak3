import { Ionicons } from '@expo/vector-icons';
import { Image } from 'expo-image';
import { LinearGradient } from 'expo-linear-gradient';
import { Link } from 'expo-router';
import { Pressable, StyleSheet, Text, View } from 'react-native';
import { tr } from '@/i18n';
import { ProviderCard as P } from '@/lib/api';
import { colors, fonts } from '@/theme';

const BLUE = '#2F80ED';

export function FeaturedTile({ p, size }: { p: P; size: number }) {
  const uri = p.cover_url ?? p.logo_url;
  const fs = Math.max(9, Math.min(13, size / 10));
  const price =
    p.min_price != null ? `${tr('من', 'From')} ${p.min_price} ${tr('ج.م', 'EGP')}` : tr('حسب العرض', 'Custom quote');

  return (
    <Link href={`/provider/${p.id}`} asChild>
      <Pressable accessibilityRole="button" accessibilityLabel={p.business_name} style={{ width: size, height: size }}>
        <View style={[styles.card, { width: size, height: size }]}>
          <View style={styles.imageWrap}>
            {uri ? (
              <Image source={{ uri }} style={StyleSheet.absoluteFill} contentFit="cover" />
            ) : (
              <LinearGradient
                colors={['rgba(74,163,255,0.45)', 'rgba(47,128,237,0.1)']}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 1 }}
                style={[StyleSheet.absoluteFill, styles.placeholder]}
              >
                <Text style={[styles.initial, { fontSize: size * 0.3, lineHeight: size * 0.4 }]}>{p.business_name.charAt(0)}</Text>
              </LinearGradient>
            )}
            <View style={styles.rating}>
              <Ionicons name="star" size={fs} color="#F59E0B" />
              <Text style={[styles.ratingText, { fontSize: fs - 1 }]}>{p.rating_avg.toFixed(1)}</Text>
            </View>
          </View>

          <LinearGradient colors={['#4AA3FF', '#1D6FE0']} start={{ x: 0, y: 0 }} end={{ x: 1, y: 0 }} style={styles.accent} />

          <View style={styles.info}>
            <View style={styles.nameRow}>
              <Text style={[styles.name, { fontSize: fs, lineHeight: fs + 2 }]} numberOfLines={1}>
                {p.business_name}
              </Text>
              {p.is_verified ? <Ionicons name="checkmark-circle" size={fs} color={BLUE} /> : null}
            </View>
            {p.description ? (
              <Text style={[styles.desc, { fontSize: fs - 1.5, lineHeight: fs + 1 }]} numberOfLines={1}>
                {p.description}
              </Text>
            ) : null}
            <Text style={[styles.price, { fontSize: fs - 0.5, lineHeight: fs + 2 }]} numberOfLines={1}>
              {price}
            </Text>
          </View>
        </View>
      </Pressable>
    </Link>
  );
}

const styles = StyleSheet.create({
  card: {
    borderRadius: 18,
    overflow: 'hidden',
    backgroundColor: 'rgba(255,255,255,0.9)',
    borderWidth: 1.5,
    borderColor: 'rgba(47,128,237,0.22)',
    shadowColor: BLUE,
    shadowOpacity: 0.16,
    shadowRadius: 12,
    shadowOffset: { width: 0, height: 6 },
  },
  imageWrap: { flex: 2, overflow: 'hidden' },
  placeholder: { alignItems: 'center', justifyContent: 'center' },
  initial: { fontFamily: fonts.bold, color: BLUE },
  accent: { height: 2.5 },
  rating: {
    position: 'absolute',
    bottom: 5,
    right: 5,
    flexDirection: 'row',
    alignItems: 'center',
    gap: 3,
    paddingHorizontal: 7,
    paddingVertical: 2,
    borderRadius: 999,
    backgroundColor: 'rgba(255,255,255,0.95)',
    borderWidth: 1,
    borderColor: 'rgba(47,128,237,0.3)',
  },
  ratingText: { fontFamily: fonts.semibold, color: '#0B1F3A' },
  info: { flex: 1, paddingHorizontal: 7, paddingVertical: 3, justifyContent: 'space-evenly' },
  nameRow: { flexDirection: 'row', alignItems: 'center', gap: 3 },
  name: { fontFamily: fonts.bold, color: colors.text, flexShrink: 1 },
  desc: { fontFamily: fonts.regular, color: colors.textSecondary },
  price: { fontFamily: fonts.bold, color: BLUE },
});
