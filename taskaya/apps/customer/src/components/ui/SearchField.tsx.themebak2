import { Ionicons } from '@expo/vector-icons';
import { useState } from 'react';
import { Platform, Pressable, StyleSheet, TextInput, View } from 'react-native';
import { tr } from '@/i18n';
import { fonts } from '@/theme';

const BLUE = '#2F80ED';

type Props = {
  value: string;
  onChangeText: (v: string) => void;
  placeholder: string;
};

export function SearchField({ value, onChangeText, placeholder }: Props) {
  const [focused, setFocused] = useState(false);

  const webField =
    Platform.OS === 'web'
      ? ({
          transition: 'box-shadow .2s ease, border-color .2s ease',
          boxShadow: focused
            ? '0 0 0 4px rgba(47,128,237,0.16), 0 8px 18px rgba(47,128,237,0.12)'
            : '0 4px 14px rgba(47,128,237,0.10)',
        } as any)
      : null;

  return (
    <View style={[styles.wrap, focused && styles.focus, webField]}>
      <Ionicons name="search" size={20} color={focused ? BLUE : '#8FA6C4'} />
      <TextInput
        value={value}
        onChangeText={onChangeText}
        placeholder={placeholder}
        placeholderTextColor="#A5B6CD"
        onFocus={() => setFocused(true)}
        onBlur={() => setFocused(false)}
        returnKeyType="search"
        autoCorrect={false}
        selectionColor={BLUE}
        accessibilityLabel={placeholder}
        style={[styles.input, Platform.OS === 'web' && ({ outlineStyle: 'none' } as any)]}
      />
      {value ? (
        <Pressable
          onPress={() => onChangeText('')}
          hitSlop={10}
          accessibilityRole="button"
          accessibilityLabel={tr('مسح البحث', 'Clear search')}
        >
          <Ionicons name="close-circle" size={20} color="#8FA6C4" />
        </Pressable>
      ) : null}
    </View>
  );
}

const styles = StyleSheet.create({
  wrap: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 12,
    height: 56,
    paddingHorizontal: 16,
    borderRadius: 16,
    backgroundColor: '#FFFFFF',
    borderWidth: 1.5,
    borderColor: '#DCE8FA',
    shadowColor: BLUE,
    shadowOpacity: 0.12,
    shadowRadius: 12,
    shadowOffset: { width: 0, height: 4 },
  },
  focus: { borderColor: BLUE, shadowOpacity: 0.28 },
  input: { flex: 1, height: '100%', fontFamily: fonts.regular, fontSize: 16, color: '#0B1F3A', backgroundColor: 'transparent' },
});
