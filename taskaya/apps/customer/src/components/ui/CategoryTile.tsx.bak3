import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import { Link } from 'expo-router';
import { ComponentProps } from 'react';
import { Pressable, StyleSheet, Text, View } from 'react-native';
import { lang } from '@/i18n';
import { Category } from '@/lib/api';
import { colors, fonts } from '@/theme';

type IconName = ComponentProps<typeof Ionicons>['name'];

const BLUE = '#2F80ED';
const ICONS: Record<string, IconName> = {
  Cleaning: 'sparkles',
  'Home Keeping': 'home',
  'Home Maintenance': 'construct',
};

export function CategoryTile({ c, size, height }: { c: Category; size: number; height: number }) {
  const icon = ICONS[c.name_en] ?? 'apps';
  const label = lang === 'ar' ? c.name_ar : c.name_en;

  const iconBox = Math.max(34, Math.min(46, Math.round(size * 0.2)));
  const fontSize = Math.max(13, Math.min(18, size / 9.5));

  return (
    <Link href={`/category/${c.id}`} asChild>
      <Pressable accessibilityRole="button" accessibilityLabel={label} style={{ width: size, height }}>
        <View style={[styles.card, { width: size, height }]}>
          <LinearGradient colors={['#4AA3FF', '#1D6FE0']} start={{ x: 0, y: 0 }} end={{ x: 1, y: 0 }} style={styles.accent} />
          <LinearGradient
            colors={['#4AA3FF', '#1D6FE0']}
            start={{ x: 0, y: 0 }}
            end={{ x: 1, y: 1 }}
            style={[styles.iconWrap, { width: iconBox, height: iconBox, borderRadius: Math.round(iconBox * 0.34) }]}
          >
            <Ionicons name={icon} size={Math.round(iconBox * 0.52)} color="#FFFFFF" />
          </LinearGradient>
          <Text
            style={[styles.name, { fontSize, lineHeight: Math.round(fontSize * 1.3) }]}
            numberOfLines={2}
            adjustsFontSizeToFit
            minimumFontScale={0.75}
          >
            {label}
          </Text>
        </View>
      </Pressable>
    </Link>
  );
}

const styles = StyleSheet.create({
  card: {
    alignItems: 'center',
    justifyContent: 'center',
    gap: 10,
    paddingHorizontal: 8,
    paddingTop: 6,
    borderRadius: 20,
    overflow: 'hidden',
    backgroundColor: 'rgba(255,255,255,0.85)',
    borderWidth: 1.5,
    borderColor: 'rgba(47,128,237,0.22)',
    shadowColor: BLUE,
    shadowOpacity: 0.16,
    shadowRadius: 14,
    shadowOffset: { width: 0, height: 6 },
  },
  accent: { position: 'absolute', top: 0, left: 0, right: 0, height: 3 },
  iconWrap: {
    alignItems: 'center',
    justifyContent: 'center',
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.55)',
    shadowColor: BLUE,
    shadowOpacity: 0.4,
    shadowRadius: 10,
    shadowOffset: { width: 0, height: 4 },
  },
  name: { fontFamily: fonts.bold, color: colors.text, textAlign: 'center', letterSpacing: 0.2 },
});
