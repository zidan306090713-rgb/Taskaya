import { Ionicons } from '@expo/vector-icons';
import { Image } from 'expo-image';
import { LinearGradient } from 'expo-linear-gradient';
import { Link } from 'expo-router';
import { useState } from 'react';
import { Animated, Pressable, StyleSheet, Text, View } from 'react-native';
import { tr } from '@/i18n';
import { ProviderCard as P } from '@/lib/api';
import { colors, fonts } from '@/theme';

const BLUE = '#2F80ED';

export function FeaturedTile({ p, size }: { p: P; size: number }) {
  const [scale] = useState(() => new Animated.Value(1));
  const press = (to: number) =>
    Animated.spring(scale, { toValue: to, useNativeDriver: true, speed: 30, bounciness: 4 }).start();

  const uri = p.cover_url ?? p.logo_url;
  const fs = Math.max(10, Math.min(13, size / 10));
  const price =
    p.min_price != null ? `${tr('من', 'From')} ${p.min_price} ${tr('ج.م', 'EGP')}` : tr('حسب العرض', 'Custom quote');
  const circle = Math.round(size * 0.34);

  return (
    <Link href={`/provider/${p.id}`} asChild>
      <Pressable
        accessibilityRole="button"
        accessibilityLabel={p.business_name}
        onPressIn={() => press(0.96)}
        onPressOut={() => press(1)}
        style={{ width: size, height: size }}
      >
        <Animated.View style={[styles.card, { width: size, height: size, transform: [{ scale }] }]}>
          <View style={styles.imageWrap}>
            {uri ? (
              <Image source={{ uri }} style={StyleSheet.absoluteFill} contentFit="cover" transition={200} />
            ) : (
              <LinearGradient
                colors={['rgba(120,185,255,0.55)', 'rgba(47,128,237,0.12)']}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 1 }}
                style={[StyleSheet.absoluteFill, styles.placeholder]}
              >
                <View style={[styles.circle, { width: circle, height: circle, borderRadius: circle / 2 }]}>
                  <Ionicons name="business" size={Math.round(circle * 0.5)} color={BLUE} />
                </View>
              </LinearGradient>
            )}
            <LinearGradient
              colors={['rgba(10,34,80,0)', 'rgba(10,34,80,0.22)']}
              style={[StyleSheet.absoluteFill, { pointerEvents: 'none' }]}
            />
            <View style={styles.rating}>
              <Ionicons name="star" size={fs} color="#F59E0B" />
              <Text style={[styles.ratingText, { fontSize: fs - 1 }]}>{p.rating_avg.toFixed(1)}</Text>
            </View>
          </View>

          <LinearGradient colors={['#4AA3FF', '#1D6FE0']} start={{ x: 0, y: 0 }} end={{ x: 1, y: 0 }} style={styles.accent} />

          <View style={styles.info}>
            <View style={styles.nameRow}>
              <Text style={[styles.name, { fontSize: fs, lineHeight: fs + 4 }]} numberOfLines={1}>
                {p.business_name}
              </Text>
              {p.is_verified ? <Ionicons name="checkmark-circle" size={fs + 1} color={BLUE} /> : null}
            </View>
            {p.description ? (
              <Text style={[styles.desc, { fontSize: fs - 1.5, lineHeight: fs + 2 }]} numberOfLines={1}>
                {p.description}
              </Text>
            ) : null}
            <Text style={[styles.price, { fontSize: fs - 0.5, lineHeight: fs + 3 }]} numberOfLines={1}>
              {price}
            </Text>
          </View>
        </Animated.View>
      </Pressable>
    </Link>
  );
}

const styles = StyleSheet.create({
  card: {
    borderRadius: 20,
    overflow: 'hidden',
    backgroundColor: 'rgba(255,255,255,0.95)',
    borderWidth: 1.5,
    borderColor: 'rgba(255,255,255,0.9)',
    shadowColor: BLUE,
    shadowOpacity: 0.14,
    shadowRadius: 14,
    shadowOffset: { width: 0, height: 8 },
    elevation: 3,
  },
  imageWrap: { flex: 1.35, overflow: 'hidden' },
  placeholder: { alignItems: 'center', justifyContent: 'center' },
  circle: {
    alignItems: 'center',
    justifyContent: 'center',
    backgroundColor: 'rgba(255,255,255,0.7)',
    borderWidth: 1,
    borderColor: 'rgba(47,128,237,0.2)',
  },
  accent: { height: 2.5 },
  rating: {
    position: 'absolute',
    bottom: 6,
    right: 6,
    flexDirection: 'row',
    alignItems: 'center',
    gap: 3,
    paddingHorizontal: 7,
    paddingVertical: 2,
    borderRadius: 999,
    backgroundColor: 'rgba(255,255,255,0.95)',
    borderWidth: 1,
    borderColor: 'rgba(47,128,237,0.25)',
  },
  ratingText: { fontFamily: fonts.semibold, color: '#0B1F3A' },
  info: { flex: 1, paddingHorizontal: 8, paddingVertical: 5, justifyContent: 'space-evenly' },
  nameRow: { flexDirection: 'row', alignItems: 'center', gap: 3 },
  name: { fontFamily: fonts.bold, color: colors.text, flexShrink: 1 },
  desc: { fontFamily: fonts.regular, color: colors.textSecondary },
  price: { fontFamily: fonts.bold, color: BLUE },
});
